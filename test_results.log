      	             "priority": 4,
      	             "words": {
      	               "wordCount": 17,
      	               "wordValue": 0.1,
      	               "result": 0.94
      	             },
      	             "readability": {
      	               "fleschKincaid": 75.12117647058825,
      	               "syllables": 23,
      	               "sentences": 1,
