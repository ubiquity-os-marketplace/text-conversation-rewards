      	                 "pre": {
      	                   "score": 0,
      	                   "elementCount": 1
      	                 }
      	               },
      	               "result": 7
      	             },
      	             "priority": 4,
      	             "words": {
      	               "wordCount": 129,
      	               "wordValue": 0.1,
      	               "result": 1.71
      	             },
      	             "readability": {
      	               "fleschKincaid": 47.78581395348837,
      	               "syllables": 214,
      	               "sentences": 7,
      	               "score": 0.8778581395348837
