      	                   "elementCount": 5
      	                 },
      	                 "pre": {
      	                   "score": 0,
      	                   "elementCount": 1
      	                 }
      	               },
      	               "result": 7
      	             },
      	             "priority": 4,
      	             "words": {
      	               "wordCount": 129,
      	               "wordValue": 0.1,
