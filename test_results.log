      	             "formatting": {
      	               "content": {
      	                 "p": {
      	                   "score": 1,
      	                   "elementCount": 3
      	                 },
      	                 "a": {
      	                   "score": 1,
      	                   "elementCount": 1
      	                 }
      	               },
      	               "result": 4
      	             },
      	             "priority": 4,
