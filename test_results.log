      	    "err": {
      	      "logMessage": {
      	        "raw": "There was a mismatch between the relevance scores and amount of comments.",
      	        "diff": "> [!CAUTION]\n> There was a mismatch between the relevance scores and amount of comments.",
      	        "type": "error",
      	        "level": "error"
