      	                   "elementCount": 1
      	                 }
      	               },
      	               "result": 4
      	             },
      	             "priority": 4,
      	             "words": {
      	               "wordCount": 134,
      	               "wordValue": 0.2,
      	               "result": 3.37
      	             },
      	             "readability": {
      	               "fleschKincaid": 53.47860696517415,
      	               "syllables": 207,
