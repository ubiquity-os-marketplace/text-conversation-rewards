      	             "priority": 4,
      	             "words": {
      	               "wordCount": 104,
      	               "wordValue": 0.2,
      	               "result": 3.66
      	             },
      	             "readability": {
      	               "fleschKincaid": 60.83172972972976,
      	               "syllables": 162,
      	               "sentences": 5,
      	               "score": 0.9916827027027024
