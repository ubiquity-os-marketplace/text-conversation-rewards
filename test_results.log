      	                 },
      	                 "li": {
      	                   "score": 1,
      	                   "elementCount": 2
      	                 },
      	                 "code": {
      	                   "score": 1,
      	                   "elementCount": 2
      	                 }
      	               },
      	               "result": 10
      	             },
      	             "priority": 4,
      	             "words": {
      	               "wordCount": 285,
      	               "wordValue": 0.1,
      	               "result": 0.71
      	             },
      	             "readability": {
      	               "fleschKincaid": 45.88453947368424,
      	               "syllables": 461,
      	               "sentences": 12,
      	               "score": 0.8588453947368424
