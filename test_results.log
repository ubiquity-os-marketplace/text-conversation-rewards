      	                   "elementCount": 3
      	                 },
      	                 "a": {
      	                   "score": 1,
      	                   "elementCount": 1
      	                 }
      	               },
      	               "result": 7
      	             },
      	             "priority": 4,
      	             "words": {
      	               "wordCount": 106,
      	               "wordValue": 0.2,
      	               "result": 3.65
      	             },
      	             "readability": {
      	               "fleschKincaid": 45.23635869565217,
